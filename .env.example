# Copia a .env (que .gitignore excluye). Ninguna clave va al repositorio.
# El sandbox NO hereda estas variables: los scripts generados corren con entorno vacio.

# ---------- Ruta del LLM ----------
# h200  -> vLLM de la USFQ (GlobalProtect conectado), costo cero
# curso -> clave del curso, fila propietario_economico de la tabla semestral
# ollama -> local, sin red
LLM_RUTA=h200

# vLLM de la H200 (puerto 12555, replica 12559). VERIFICAR la IP con el README del Lab-03:
# esta es la del Taller 02.
OPENAI_BASE_URL=http://172.28.230.10:12555/v1
H200_LLM_REPLICA_URL=http://172.28.230.10:12559/v1
# vLLM no pide clave real, pero el SDK de OpenAI exige una cadena no vacia
OPENAI_API_KEY=EMPTY
# El id del modelo NO se escribe a mano: se lee de /v1/models. Dejar vacio.
LLM_MODELO=

# ---------- Embeddings ----------
# bge-m3 en el Ollama de la H200 (el /v1/embeddings del 12555 responde 404)
EMBED_URL=http://172.28.230.10:11434
EMBED_MODELO=bge-m3

# ---------- Frenos (Parte 3) ----------
SOLVER_PRESUPUESTO_TOKENS=200000
SOLVER_RESERVA_REDACTOR=20000
SOLVER_MAX_INTENTOS=3
SANDBOX_TIMEOUT_S=120
